[Unit]
Description=Quiet Gambit Next.js development server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/tim/Repo/chess-ai
Environment=PATH=/home/tim/.nvm/versions/node/v24.6.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/tim/.nvm/versions/node/v24.6.0/bin/npm run dev:test
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
